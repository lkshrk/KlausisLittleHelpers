package-as: KlausisLittleHelpers
externals:
  Libs/LibStub: https://repos.wowace.com/wow/ace3/tags/Release-r1403/LibStub
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/ace3/tags/Release-r1403/CallbackHandler-1.0
  Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/tags/Release-r1403/AceEvent-3.0
  Libs/AceDB-3.0: https://repos.wowace.com/wow/ace3/tags/Release-r1403/AceDB-3.0
  Libs/AceDBOptions-3.0: https://repos.wowace.com/wow/ace3/tags/Release-r1403/AceDBOptions-3.0
  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1.git
    tag: v1.1.4
  Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/tags/v12.1.2/LibDBIcon-1.0

ignore:
  - .claude
  - .codex
  - .ctxtmp
  - .cursor
  - .editorconfig
  - .gemini
  - .gitattributes
  - .github
  - .gitleaks.toml
  - .luacheckrc
  - .luarc.json
  - .mcp.json
  - .superpowers
  - .tools
  - .worktrees
  - AGENTS.md
  - CLAUDE.md
  - docs
  - lefthook.yml
  - CONTRIBUTING.md
  - README.md
  - renovate.json5
  - scripts
  - tests
